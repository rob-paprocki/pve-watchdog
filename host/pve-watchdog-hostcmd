STDIN = ""          # set by main() for verbs that take their data on stdin
HISTORY_KEEP = 10


def HISTORY():
    return PVE + "/pve-watchdog/history"


def cluster_guests():
    p = run(["pvesh", "get", "/cluster/resources", "--type", "vm", "--output-format", "json"],
            timeout=60)
    return json.loads(p.stdout)


def v_list_guests(cfg):
    """Every container and VM in the cluster, with what pve-watchdog thinks of it."""
    ctl = {n["controller_id"]: n["name"] for n in cfg["node"]}
    covered = {c["id"]: c for c in cfg.get("ct", [])}
    standby_of = {c["id"] + offset(cfg): c["id"] for c in cfg.get("ct", []) if container_mode(c)}
    out = []
    for r in cluster_guests():
        vmid, kind = int(r["vmid"]), r.get("type")
        g = {"id": vmid, "type": kind, "node": r.get("node"), "name": r.get("name", ""),
             "status": r.get("status"), "tags": r.get("tags", ""), "ip": None,
             "role": "controller" if vmid in ctl else
                     "standby" if vmid in standby_of else
                     "covered" if vmid in covered else None,
             "standby_of": standby_of.get(vmid)}
        if kind == "lxc":
            p = run(["pvesh", "get", "/nodes/%s/lxc/%d/config" % (r["node"], vmid),
                     "--output-format", "json"], check=False, timeout=30)
            try:
                net0 = json.loads(p.stdout).get("net0", "")
                m = re.search(r"ip=(\d+\.\d+\.\d+\.\d+)", net0)
                g["ip"] = m.group(1) if m else None
            except ValueError:
                pass
        out.append(g)
    return sorted(out, key=lambda g: g["id"])


def _write_config_with_history(text, who):
    os.makedirs(HISTORY(), exist_ok=True)
    if os.path.exists(CONFIG()):
        shutil.copy2(CONFIG(), "%s/config-%d.toml" % (HISTORY(), int(now())))
    old = sorted(glob.glob(HISTORY() + "/config-*.toml"))
    for f in old[:-HISTORY_KEEP]:
        os.unlink(f)
    with open(CONFIG() + ".new", "w") as f:
        f.write(text)
    os.replace(CONFIG() + ".new", CONFIG())
    log("config saved by %s" % who)


@with_lock
def v_put_config(cfg, who):
    """Replace config.toml with the text on stdin, after full validation."""
    who = re.sub(r"[^A-Za-z0-9@._-]", "", who)[:64] or "?"
    try:
        new = tomllib.loads(STDIN)
    except tomllib.TOMLDecodeError as e:
        raise Refused("not valid TOML: %s" % e)
    validate_cfg(new)
    # Each covered guest must exist as a container (or already be covered:
    # during a takeover a file-mode CT can briefly be registered nowhere).
    guests = cluster_guests()
    kinds = {int(r["vmid"]): r.get("type") for r in guests}
    tags = {int(r["vmid"]): re.split(r"[;,\s]+", r.get("tags") or "") for r in guests}
    for c in new.get("ct", []):
        if c.get("mode", "off") != "off" and c.get("standby") == "container":
            sb = c["id"] + int(new.get("cluster", {}).get("standby_offset", 1000))
            if sb in kinds and STANDBY_TAG not in tags.get(sb, []):
                raise Refused("CT %d's standby ID %d already belongs to another guest (it has "
                              "no %s tag); choose a different standby_offset or free that ID"
                              % (c["id"], sb, STANDBY_TAG))
    before = {c["id"] for c in cfg.get("ct", [])}
    for c in new.get("ct", []):
        if c.get("mode", "off") == "off" or c["id"] in before:
            continue
        if kinds.get(c["id"]) != "lxc":
            raise Refused("CT %d is not a container in this cluster%s" % (
                c["id"], " (VMs are not supported yet)" if kinds.get(c["id"]) == "qemu" else ""))
    _write_config_with_history(STDIN, who)
    return {"saved": True}


def v_config_history(cfg):
    out = []
    for f in sorted(glob.glob(HISTORY() + "/config-*.toml"), reverse=True):
        out.append({"ts": int(re.search(r"config-(\d+)\.toml", f).group(1)),
                    "size": os.path.getsize(f)})
    return out


@with_lock
def v_restore_config(cfg, ts, who):
    ts = int(parse_vmid(ts)) if not str(ts).isdigit() else int(ts)
    path = "%s/config-%d.toml" % (HISTORY(), ts)
    if not os.path.exists(path):
        raise Refused("no saved config from %s" % ts)
    with open(path) as f:
        text = f.read()
    validate_cfg(tomllib.loads(text))
    _write_config_with_history(text, re.sub(r"[^A-Za-z0-9@._-]", "", who)[:64] + " (restore)")
    return {"restored": ts}


@with_lock
def v_put_secret(cfg, key):
    """Set one value in the root-only secret file (value on stdin)."""
    if key != "discord_webhook":
        raise Refused("only discord_webhook can be set")
    value = STDIN.strip()
    if value and not re.fullmatch(r"https://(discord|discordapp)\.com/api/webhooks/\d+/[A-Za-z0-9_-]+",
                                  value):
        raise Refused("that is not a Discord webhook URL")
    text = open(SECRET()).read() if os.path.exists(SECRET()) else ""
    line = 'discord_webhook = "%s"' % value
    if re.search(r"(?m)^discord_webhook\s*=.*$", text):
        text = re.sub(r"(?m)^discord_webhook\s*=.*$", line, text)
    else:
        text = text.rstrip("\n") + "\n" + line + "\n"
    tomllib.loads(text)
    with open(SECRET(), "w") as f:
        f.write(text)
    log("secret %s %s" % (key, "set" if value else "cleared"))
    return {"set": bool(value)}


def v_check_login(cfg):
    """Check a Proxmox username/password (JSON on stdin) against THIS host's
    own Proxmox API. Only says yes/no and whether the user is an admin; the
    Proxmox ticket is never passed on."""
    import hashlib
    import http.client
    import ssl
    import urllib.parse
    try:
        data = json.loads(STDIN)
        user, password = str(data["username"]).strip(), str(data["password"])
    except (ValueError, KeyError):
        raise Refused("expected {username, password}")
    if "@" not in user:
        user += "@pam"
    # The certificate pveproxy serves must be exactly the one on this host's
    # disk (custom pveproxy-ssl.pem if present, else the cluster-issued
    # pve-ssl.pem). Pinning it avoids any reliance on host names or CAs.
    pem = "%s/local/pveproxy-ssl.pem" % PVE
    if not os.path.exists(pem):
        pem = "%s/local/pve-ssl.pem" % PVE
    with open(pem) as f:
        expected = hashlib.sha256(ssl.PEM_cert_to_DER_cert(f.read())).digest()
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE        # replaced by the exact pin check below
    conn = http.client.HTTPSConnection("127.0.0.1", 8006, context=ctx, timeout=15)
    try:
        conn.connect()
        if hashlib.sha256(conn.sock.getpeercert(binary_form=True)).digest() != expected:
            raise Refused("the Proxmox API certificate does not match this host's own; "
                          "refusing to send the password")
        body = urllib.parse.urlencode({"username": user, "password": password})
        conn.request("POST", "/api2/json/access/ticket", body,
                     {"Content-Type": "application/x-www-form-urlencoded"})
        resp = conn.getresponse()
        raw = resp.read()
        safe_user = re.sub(r"[^A-Za-z0-9@._-]", "", user)[:64]
        if resp.status != 200:
            log("web UI login refused for %s" % safe_user)
            return {"ok": False}
        d = json.loads(raw).get("data") or {}
        # An account with two-factor auth only gets a half ticket here: refuse.
        if d.get("NeedTFA") or not d.get("ticket") or str(d.get("ticket")).find("!tfa!") >= 0:
            log("web UI login for %s needs two-factor; not supported" % safe_user)
            return {"ok": False, "tfa": True}
        # Real permissions on the cluster root, not the summary hints.
        conn.request("GET", "/api2/json/access/permissions?path=%2F", headers={
            "Cookie": "PVEAuthCookie=" + urllib.parse.quote(d["ticket"], safe="")})
        presp = conn.getresponse()
        perms = (json.loads(presp.read()).get("data") or {}).get("/", {}) if presp.status == 200 else {}
    finally:
        conn.close()
    admin = bool(perms.get("Sys.Modify")) and bool(perms.get("VM.PowerMgmt")) and \
        bool(perms.get("VM.Allocate"))
    log("web UI login ok for %s (admin=%s)" % (d.get("username"), admin))
    return {"ok": True, "user": d.get("username", user), "admin": admin}


def v_maintenance(cfg, what, seconds=None):
    """Cluster-wide maintenance flag in /etc/pve (needs quorum to write).

    Not gated by dry-run: it only ever SUPPRESSES actions."""
    if what == "off":
        if os.path.exists(MAINT()):
            os.unlink(MAINT())
        log("maintenance off")
        return {"active": False}
    if what != "on":
        raise Refused("maintenance on <seconds> | off")
    secs = int(seconds or 3600)
    cap = int(cfg.get("policy", {}).get("maintenance_max_hours", 8) * 3600)
    secs = max(60, min(secs, cap))
    m = {"until": now() + secs, "set_by": me(), "set_at": now()}
    os.makedirs(os.path.dirname(MAINT()), exist_ok=True)
    with open(MAINT(), "w") as f:
        json.dump(m, f)
    log("maintenance on for %d s" % secs)
    m["active"] = True
    return m


VERBS = {
    # name           (function,        number of arguments allowed)
    "status":        (v_status,        (0,)),
    "get-config":    (v_get_config,    (0,)),
    "probe":         (v_probe,         (1,)),
    "backup":        (v_backup,        (1, 2)),
    "push":          (v_push,          (2,)),
    "start":         (v_start,         (1,)),
    "stop":          (v_stop,          (1,)),
    "adopt":         (v_adopt,         (1,)),
    "refresh":       (v_refresh,       (1,)),
    "list-guests":   (v_list_guests,   (0,)),
    "put-config":    (v_put_config,    (1,)),     # config text on stdin
    "config-history": (v_config_history, (0,)),
    "restore-config": (v_restore_config, (2,)),
    "put-secret":    (v_put_secret,    (1,)),     # value on stdin
    "check-login":   (v_check_login,   (0,)),     # {username, password} on stdin
    "activate":      (v_activate,      (2,)),
    "force-quorum":  (v_force_quorum,  (0,)),
    "claim":         (v_claim,         (2,)),
    "release":       (v_release,       (1,)),
    "restore":       (v_restore,       (1,)),
    "free-orphans":  (v_free_orphans,  (1,)),
    "maintenance":   (v_maintenance,   (1, 2)),
}


def main(argv):
    # When called through the locked-down SSH key, the requested command
    # arrives in SSH_ORIGINAL_COMMAND; when run by hand, in argv.
    raw = os.environ.get("SSH_ORIGINAL_COMMAND")
    words = shlex.split(raw) if raw is not None else argv[1:]
    if words and os.path.basename(words[0]) == "pve-watchdog-hostcmd":
        words = words[1:]
    global FORCE_DRY
    if words and words[0] == "--dry-run":      # "show me, change nothing"
        FORCE_DRY = True
        words = words[1:]
    global STDIN
    if words and words[0] in ("put-config", "put-secret", "check-login"):
        STDIN = sys.stdin.read(256 * 1024)        # never logged
    if not words or words[0] not in VERBS:
        print(json.dumps({"ok": False, "error": "unknown verb; allowed: " + ", ".join(VERBS)}))
        return 2
    fn, nargs = VERBS[words[0]]
    args = words[1:]
    if len(args) not in nargs:
        print(json.dumps({"ok": False, "error": "wrong number of arguments"}))
        return 2
    try:
        cfg = load_cfg()
        result = fn(cfg, *args)
        print(json.dumps({"ok": True, "result": result}))
        return 0
    except Refused as e:
        log("REFUSED %s: %s" % (" ".join(words), e))
        print(json.dumps({"ok": False, "refused": True, "error": str(e)}))
        return 3
    except Exception as e:                       # report, never hang the brain
        log("ERROR %s: %s" % (" ".join(words), e))
        print(json.dumps({"ok": False, "error": "%s: %s" % (type(e).__name__, e)}))
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
